{
  "name": "tcp-controller",
  "version": "3.0.0",
  "description": "TCP and TLS gateway with decorators and no runtime dependencies.",
  "main": "./dist/cjs/index.js",
  "module": "./dist/esm/index.js",
  "types": "./dist/cjs/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/esm/index.d.ts",
        "default": "./dist/esm/index.js"
      },
      "require": {
        "types": "./dist/cjs/index.d.ts",
        "default": "./dist/cjs/index.js"
      }
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "LICENSE",
    "README.md"
  ],
  "sideEffects": false,
  "scripts": {
    "build": "npm run clean && tsc -p tsconfig.build.cjs.json && tsc-alias -p tsconfig.build.cjs.json && tsc -p tsconfig.build.esm.json && tsc-alias -p tsconfig.build.esm.json --resolve-full-paths && node scripts/mark-dist-types.mjs",
    "clean": "rm -rf dist",
    "test": "tsc -p tsconfig.test.json && tsc-alias -p tsconfig.test.json && node scripts/run-tests.mjs",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "check": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.test.json --noEmit",
    "prepare": "npm run build"
  },
  "keywords": [
    "tcp",
    "tls",
    "decorators",
    "gateway"
  ],
  "author": "Muryllo Pimenta de Oliveira",
  "license": "MIT",
  "funding": {
    "type": "ko-fi",
    "url": "https://ko-fi.com/murylloex"
  },
  "engines": {
    "node": ">=18"
  },
  "devDependencies": {
    "@types/node": "^24.9.1",
    "prettier": "^3.9.10",
    "tsc-alias": "^1.9.5",
    "typescript": "^7.0.2"
  }
}
